# Informações do Projeto
PROJECT_NAME=CRM Backend
VERSION=1.0.0
API_V1_STR=/api/v1

# Banco de Dados PostgreSQL
POSTGRES_SERVER=db
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password
POSTGRES_DB=crm_db
POSTGRES_PORT=5432

# Segurança JWT
SECRET_KEY=sua_chave_secreta_super_segura_aqui_mude_em_producao_use_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - Origens permitidas (separe por vírgula ou use *)
BACKEND_CORS_ORIGINS=*

# N8N Integration (opcional - configure se for usar)
# N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/crm

# Integração Evolution API
EVOLUTION_API_URL=https://sua-url-da-evolution.com
EVOLUTION_API_KEY=sua-apikey-global-aqui